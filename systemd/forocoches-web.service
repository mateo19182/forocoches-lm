[Unit]
Description=forocoches-lm web (model playground + dataset browser) on port 7862
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/projects/forocoches-lm
ExecStart=%h/projects/forocoches-lm/.venv-train/bin/python -m uvicorn web.app:app --host 0.0.0.0 --port 7862
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
